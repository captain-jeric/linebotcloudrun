LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
BOT_USER_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_TOKEN=
ADMIN_TAILSCALE_ONLY=false
ADMIN_ALLOWED_EMAILS=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
PORT=8080
LOG_FULL_WEBHOOK_BODY=false

# Stripe 支付（PromptPay / Alipay 扫码，一次性付款，货币为 THB）
# 未配置 STRIPE_SECRET_KEY 时支付页显示“即将上线”，支付按钮禁用。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 可选：支付方式，逗号分隔，默认 promptpay。Alipay 启用后改为 promptpay,alipay
STRIPE_PAYMENT_METHODS=promptpay
# 可选：对外域名，用于 Stripe 回跳的 success/cancel URL；留空则按请求 host 推断
PUBLIC_BASE_URL=

# Cloud Run 推荐方式：
# 1. 给 Cloud Run runtime service account 授权 Cloud Translation API；或
# 2. 把 service-account.json 的完整 JSON 放进 Secret Manager，再映射到这个环境变量。
GOOGLE_APPLICATION_CREDENTIALS_JSON=
